 namespace FEX::Windows {
+namespace {
+/* iOS-Madeira: IntervalsLock RE-ENTRY FROM FEX'S OWN MEMORY NOTIFICATIONS.
+ *
+ * Steam froze at startup (steam.exe main thread parked forever, cmd window left open) with
+ * this as the last output of the thread:
+ *
+ *   [iOS-xins] tracker=0x14e63dff0 rpcrt4.dll sec=0x71f7f10000-0x71f7f5b27f
+ *   [vfree] ml842 # base=0x7c010c1000 size=0xf000 type=0x4000 tid=005c
+ *   [waiters]  tid=005c addr=0x14e63e028 age=284s INF   <- tracker+0x38, inside IntervalsLock
+ *
+ * HandleImageMap() logs while holding IntervalsLock exclusively. Formatting that line made
+ * FEX's allocator decommit one of its own arena pages, NtFreeVirtualMemory called back into
+ * NotifyMemoryFree -> InvalidateAlignedInterval(), which takes IntervalsLock again on the same
+ * thread: a non-recursive shared_mutex, so the thread waited on itself forever. Any allocation
+ * under the lock (an IntervalList growing, for instance) can do the same.
+ *
+ * Record the exclusive owner, and have the notification entry points skip the work when the
+ * current thread is that owner. Only FEX runs on a thread inside this tracker's critical
+ * section, so such a notification is FEX's own heap (the FEX_ONLY arena), never guest code:
+ * there is no executable interval to drop and no translated code to invalidate. */
+class IntervalsWriteScope {
+public:
+  explicit IntervalsWriteScope(std::atomic<DWORD>& Owner)
+    : Owner {Owner} {
+    Owner.store(GetCurrentThreadId(), std::memory_order_relaxed);
+  }
+  ~IntervalsWriteScope() {
+    Owner.store(0, std::memory_order_relaxed);
+  }
+  IntervalsWriteScope(const IntervalsWriteScope&) = delete;
+  IntervalsWriteScope& operator=(const IntervalsWriteScope&) = delete;
+
+private:
+  std::atomic<DWORD>& Owner;
+};
+
+void LogReentrantSkip(const char* Path, uint64_t Address, uint64_t Size) {
+  static std::atomic<uint32_t> Count {0};
+  const auto N = Count.fetch_add(1, std::memory_order_relaxed) + 1;
+  // Few lines only: the log call itself allocates and can come straight back here.
+  if (N <= 4) {
+    LogMan::Msg::EFmt("[iOS-xreent] {} #{} {:#x}+{:#x} skipped: this thread already holds IntervalsLock", Path, N, Address, Size);
+  }
+}
+} // namespace
+
+bool InvalidationTracker::ThreadHoldsIntervalsWrite() const {
+  // Only the owner stores its own id, so a relaxed load can only match on that very thread.
+  const DWORD Tid = GetCurrentThreadId();
+  return Tid && IntervalsWriterTid.load(std::memory_order_relaxed) == Tid;
+}
