#!/bin/bash
# CI-only stand-in for xcrun, installed as "xcrun" ahead of /usr/bin on PATH.
# The native build scripts compile with `xcrun -sdk <sdk> clang|clang++ ...`,
# which a PATH-level ccache symlink cannot intercept because xcrun resolves
# the tool inside the toolchain. Route exactly that form through ccache with
# the same SDKROOT xcrun would set; every other invocation (metal, ar,
# libtool, -f, --show-sdk-path, ...) goes to the real xcrun untouched.
REAL=/usr/bin/xcrun
if [ "$#" -ge 3 ] && { [ "$1" = "-sdk" ] || [ "$1" = "--sdk" ]; } \
   && { [ "$3" = "clang" ] || [ "$3" = "clang++" ]; } && command -v ccache >/dev/null; then
    sdk=$2 tool=$3
    shift 3
    compiler=$("$REAL" -sdk "$sdk" -f "$tool") || exec "$REAL" -sdk "$sdk" "$tool" "$@"
    SDKROOT=$("$REAL" -sdk "$sdk" --show-sdk-path) || exec "$REAL" -sdk "$sdk" "$tool" "$@"
    export SDKROOT
    exec ccache "$compiler" "$@"
fi
exec "$REAL" "$@"
